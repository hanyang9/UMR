{
  "extends": "../humanoid_retarget_defaults.json",
  "smpl_template": {
    "source": "motion",
    "type": "smplx",
    "use_betas": true,
    "use_gender": true,
    "name": "auto"
  },
  "correspondence": {
    "slots_field": "reconstructed_slots",
    "smpl_name": "smplx_racket_tpose",
    "dataset": {
      "out": "../output/correspondence_unitree_g1_racket_adapt/dataset.npz",
      "num_points": 4096,
      "seed": 0,
      "smpl_center": "spine1",
      "bbox_center_ratio": 0.45,
      "surface_oversample_ratio": 8,
      "surface_curvature_weight": 0.0,
      "surface_curvature_power": 1.0,
      "exterior_surface": true,
      "exterior_method": "first_hit",
      "exterior_occlusion_distance": 0.12,
      "exterior_ray_distance": 0.0
    },
    "train": {
      "out_dir": "../output/correspondence_unitree_g1_racket_adapt",
      "template_name": "smplx_racket_tpose",
      "template_sort": "y_z_x",
      "normalize": "per_sample_height",
      "epochs": 500,
      "batch_size": 2,
      "device": "auto",
      "lr": 0.001,
      "lr_scheduler": "cosine",
      "min_lr": 0.00001,
      "chamfer_weight": 1.0,
      "repulsion_weight": 0.002,
      "repulsion_k": 8,
      "repulsion_radius": 0.035,
      "residual_weight": 0.0,
      "edge_weight": 0.4,
      "edge_graph": "geodesic",
      "edge_k": 32,
      "noise_std": 0.002,
      "dropout_ratio": 0.0,
      "resample_every": 0,
      "log_every": 100,
      "save_every": 1000,
      "seed": 0,
      "extra_args": {
        "latent_dim": 1024,
        "hidden_dim": 512,
        "robot_height": 1.32
      }
    }
  },
  "motion": {
    "data": "../output/adapt_prepared/DUANXIRAN_FQ_2qu_pingji_neijiao_T1_30fps_smplx.npz",
    "seq_key": "DUANXIRAN_FQ_2qu_pingji_neijiao_T1_30fps_smplx",
    "seq_index": 0,
    "start": 0,
    "end": -1,
    "stride": 1,
    "max_frames": 0
  },
  "solver": {
    "surface_normal_cost_mode": "tpose_offset",
    "body_segment": {
      "module": "retarget_body_segment_surface_adapt",
      "schema": "19",
      "upper_arm_split": {
        "ratio_start": 0.0,
        "ratio_end": 0.3
      },
      "object_contact_target": "composite_racket_slots",
      "composite_racket": {
        "enabled": true,
        "source_tpose_npz": "../sample_data/adapt/duanxiran_fq2/source_smplx_tpose.npz",
        "tpose_npz": "../sample_data/adapt/duanxiran_fq2/source_racket_tpose.npz",
        "trajectory_npz": "../output/adapt_prepared/FQ_2qu_pingji_neijiao_T1_30fps_racket_trajectory.npz"
      }
    },
    "ground_contact_map_cost": 10.0,
    "ground_contact_anchor_cost": 5.0,
    "ground_contact_map_threshold": 0.1,
    "ground_contact_map_snap_threshold": 0.005,
    "ground_contact_map_max_points": 128,
    "ground_penetration_hard_constraint": true,
    "ground_penetration_hard_constraint_mode": "surface_slots_all",
    "ground_penetration_margin": 0.0,
    "ground_penetration_hard_slack": false,
    "ground_penetration_hard_slack_cost": 1000.0,
    "ground_penetration_threshold": 0.05,
    "ground_penetration_max_points": 128,
    "self_contact_map_cost": 500.0,
    "self_contact_map_mode": [
      "threshold_global_topk",
      "source_clearance_body_pair_topk"
    ],
    "self_contact_map_threshold": 0.1,
    "self_contact_map_max_pairs": 256,
    "self_contact_map_body_topk": {
      "default": 1
    },
    "object_contact_map_cost": 10.0,
    "object_contact_map_threshold": 0.1,
    "object_contact_map_snap_threshold": 0.005,
    "object_contact_map_max_points": 128,
    "object_contact_map_samples": 1024,
    "retarget_object_size": "scaled",
    "robot_object_penetration_soft_cost": 0.0,
    "robot_object_hard_constraint": false,
    "robot_object_margin": 0.0,
    "robot_object_hard_slack": false,
    "robot_object_hard_slack_cost": 0.0,
    "robot_object_threshold": 0.1,
    "robot_object_max_pairs": 128,
    "smooth_cost": 1.0,
    "temporal_smooth_cost": 0.5,
    "trajectory_filter_mode": "lqr",
    "trajectory_filter_data_cost": 1.0,
    "trajectory_filter_velocity_cost": 0.0,
    "trajectory_filter_acceleration_cost": 0.1,
    "trajectory_filter_jerk_cost": 0.01,
    "trajectory_filter_root_translation": true,
    "trajectory_filter_anchor_start_frames": 1,
    "trajectory_filter_anchor_end_frames": 1,
    "trajectory_warm_start_mode": "bidirectional",
    "trajectory_warm_start_bidirectional_continuity_cost": 0.1,
    "trajectory_warm_start_bidirectional_switch_cost": 0.01,
    "damping": 0.01,
    "collision_threshold": 0.1,
    "robot_self_penetration_cost": 0.0,
    "robot_self_penetration_hard_constraint": false,
    "robot_self_penetration_margin": -0.001,
    "robot_self_penetration_hard_slack": true,
    "robot_self_penetration_hard_slack_cost": 1000.0,
    "iters": 1,
    "pose_init_iters": 15,
    "step_limit_mode": "l2",
    "max_dq": 0.15,
    "global_step_size": 0.4,
    "root_step_limit_mode": "off",
    "root_max_translation_dq": 0.3,
    "root_max_rotation_dq": 0.5,
    "root_global_translation_step_size": 0.3,
    "root_global_rotation_step_size": 0.5,
    "seed": 0,
    "batch_size": 32,
    "bind_nearest_vertex_k": 24,
    "project_robot_slots": true
  },
  "retarget": {
    "out": "../output/unitree_g1_racket_retarget_adapt/DUANXIRAN_FQ_2qu_pingji_neijiao_T1_adapt.npz",
    "human_height": 0.0,
    "mat_height": 0.0,
    "source_ground_align": "none",
    "zero_source_finger_pose": true,
    "stream_chunk_frames": 10800,
    "save_source_debug": false,
    "smplx_device": "cuda",
    "smplx_batch_size": 7567,
    "smplx_batch_size_max": 10000,
    "smplx_batch_size_safety_factor": 0.8
  },
  "view": {
    "enabled": true,
    "play": true,
    "rate_limit": true,
    "extra_args": {
      "viewer_backend": "glfw-ui",
      "ghost_trail": false,
      "ghost_interval": 1.0,
      "show_left_ui": false,
      "show_right_ui": false,
      "show_source_slots": false,
      "show_robot_slots": false,
      "show_ground_contact_map": false
    }
  },
  "adapt": {
    "source_slot_name": "smplx_racket_tpose",
    "source_motion_npz": "../sample_data/adapt/duanxiran_fq2/source_motion.npz",
    "racket_trajectory_npz": "../sample_data/adapt/duanxiran_fq2/source_racket_trajectory.npz",
    "source_tpose_npz": "../sample_data/adapt/duanxiran_fq2/source_smplx_tpose.npz",
    "racket_tpose_npz": "../sample_data/adapt/duanxiran_fq2/source_racket_tpose.npz",
    "prepared_motion_npz": "../output/adapt_prepared/DUANXIRAN_FQ_2qu_pingji_neijiao_T1_30fps_smplx.npz",
    "prepared_racket_trajectory_npz": "../output/adapt_prepared/FQ_2qu_pingji_neijiao_T1_30fps_racket_trajectory.npz",
    "correspondence_viewer_out": "../output/adapt_correspondence_viewer",
    "downsample_stride": 4,
    "target_fps": 30.0,
    "source_output_up": "y"
  }
}
